{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.2",
  "provider": {
    "openrouter": { "options": { "apiKey": "{file:/run/secrets/breakout-key}" } },
    "anthropic": { "options": { "apiKey": "{file:/run/secrets/breakout-key}" } }
  },
  "permission": {
    "bash": "allow", "edit": "allow", "write": "allow",
    "read": "deny", "grep": "deny", "glob": "deny", "webfetch": "deny", "websearch": "deny"
  }
}
