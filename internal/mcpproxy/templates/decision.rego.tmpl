{{.Header}}
package sift.decision

import rego.v1

# Aggregate every category's deny set into a single structured decision.
# Each reason is prefixed with its source package for traceability.
# allowed is true only when no category produced a deny that an operator
# override did not waive (G3).
{{range .PolicyPackages}}
deny_reasons contains msg if {
	some r in data.sift.{{.}}.deny
	msg := sprintf("sift.{{.}}: %s", [r])
}
{{end}}

# waived(msg) is true when a ceiling-bounded operator override (G3) covers the
# source package of a deny reason. sift.override has already intersected the
# override's request with the operator ceiling, so matching here is safe.
waived(msg) if {
	some pkg in data.sift.override.cleared_packages
	startswith(msg, sprintf("sift.%s:", [pkg]))
}

# reasons are the deny reasons that still stand after any override — what the
# proxy reports and acts on.
reasons contains msg if {
	some msg in deny_reasons
	not waived(msg)
}

# waived_reasons are the deny reasons an override cleared, surfaced for audit
# provenance only (never part of the allow decision).
waived_reasons contains msg if {
	some msg in deny_reasons
	waived(msg)
}

default allowed := false

allowed if count(reasons) == 0

# Override provenance for the audit trail.
default override_active := false

override_active if data.sift.override.active

override_issuer := input.context.operator_override.iss

# Approved URI-scoped transient egress targets (G4), surfaced from the
# always-compiled sift.uri_egress package. Empty unless the proxy populates
# input.context.requested_uris for an opted-in server.
egress_targets contains t if {
	some t in data.sift.uri_egress.egress_targets
}

policies_evaluated := [
{{- range .PolicyPackages}}
	"sift.{{.}}",
{{- end}}
]
